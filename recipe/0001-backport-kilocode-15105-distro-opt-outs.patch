From 7195329aa542f5c54e55044e67937850e1207de9 Mon Sep 17 00:00:00 2001
From: Jamie Robertson <jamierobertsongames@gmail.com>
Date: Thu, 15 Oct 2026 09:56:47 +0100
Subject: [PATCH] fix(cli): let distro builds use the host bun and skip the
 release upload

Builds on https://github.com/Kilo-Org/kilocode/pull/15105 for the conda
build; remove this patch once an equivalent change is released upstream.

Adds two opt-outs to script/build.ts, in the style of
KILO_SKIP_BUNDLED_BWRAP (build.sh / bld.bat set them):

- KILO_USE_HOST_BUN=1 embeds the bun running the build (conda's bun,
  built from source at the pinned revision that build.ts already checks)
  as the native target's runtime, like the Nix path, instead of
  downloading the prebuilt npm runtime. The existing
  `runtime !== process.execPath` check then also skips the patchelf
  interpreter rewrite. Non-native targets fail instead of downloading.
- KILO_SKIP_RELEASE_UPLOAD=1 keeps the release build settings (no
  sourcemaps, release build kind) but skips packing, SBOM evidence and
  the GitHub upload.
---
 packages/opencode/script/build.ts | 17 +++++++++++------
 1 file changed, 11 insertions(+), 6 deletions(-)

diff --git a/packages/opencode/script/build.ts b/packages/opencode/script/build.ts
index 908677db5e..acdbe7ecae 100755
--- a/packages/opencode/script/build.ts
+++ b/packages/opencode/script/build.ts
@@ -294,12 +294,14 @@ for (const item of targets) {
   await $`mkdir -p dist/${name}/bin`
   // kilocode_change start
   // Nix already verifies its runtime with fetchurl and builds without network access.
+  // KILO_USE_HOST_BUN=1: distro builds embed the bun running this script (built
+  // from source at the revision checked above) instead of downloading one.
+  const native = item.os === process.platform && item.arch === process.arch && !item.abi && item.avx2 !== false
+  if (process.env.KILO_USE_HOST_BUN === "1" && !native) {
+    throw new Error(`KILO_USE_HOST_BUN=1 only builds the native target, not ${name}`)
+  }
   const runtime =
-    process.env.NIX_BUILD_TOP &&
-    item.os === process.platform &&
-    item.arch === process.arch &&
-    !item.abi &&
-    item.avx2 !== false
+    (process.env.NIX_BUILD_TOP || process.env.KILO_USE_HOST_BUN === "1") && native
       ? process.execPath
       : await KiloBun.stage(item)
   const bwrap =
@@ -468,7 +470,10 @@ for (const item of targets) {
   binaries[name] = Script.version
 }
 
-if (Script.release) {
+// kilocode_change start - KILO_SKIP_RELEASE_UPLOAD=1 keeps the release build
+// settings but skips packing, SBOM evidence and the GitHub upload (distro builds)
+if (Script.release && process.env.KILO_SKIP_RELEASE_UPLOAD !== "1") {
+  // kilocode_change end
   const archives: string[] = [] // kilocode_change
   for (const key of Object.keys(binaries)) {
     const archive = key.replace(pkg.name, "kilo") // kilocode_change
